# Build-time configuration for Vite.
#
# IMPORTANT: every VITE_* value is embedded into the public browser bundle.
# Never put passwords, API keys, JWT secrets or private keys here.
#
# With the root docker-compose.yml this value is passed automatically as a
# Docker build arg. Use this file only for a manual `npm run build` / `docker build`.
VITE_API_BASE_URL=https://api.your-domain.tld
