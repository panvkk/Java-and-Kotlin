# =============================================================================
# money-pusher — local development environment
#
# Copy this file to .env and replace every "change-me" value:
#     cp .env.example .env
#
# .env is git-ignored. NEVER commit it.
#
# How it is used:
#   * Docker Compose reads money-pusher/.env automatically for ${VAR}
#     substitution in docker-compose.yml.
#   * Spring Boot reads it in local runs through
#     spring.config.import=optional:file:.../.env[.properties].
#     In Docker/CI the same names are injected as real environment variables.
#
# Keep the file in plain KEY=VALUE form: no quotes, no "export", no spaces
# around "=". Spring's properties parser and Compose's dotenv parser both
# accept this subset.
# =============================================================================

# --- JWT ---------------------------------------------------------------------
# Must be identical for auth-service and api-gateway.
# Generate a new one with:  openssl rand -base64 32
# The placeholder below is intentionally invalid: auth-service will refuse to
# start issuing tokens until you replace it.
JWT_SECRET=change-me-base64-encoded-32-bytes
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
AUTH_DB_NAME=money-pusher_db
CLICKER_DB_NAME=clicker-service_db
TRANSFER_DB_NAME=transfer-service_db

# --- JDBC URLs (local runs: services on the host, databases in Docker) --------
AUTH_DB_URL=jdbc:postgresql://localhost:5432/money-pusher_db
CLICKER_DB_URL=jdbc:postgresql://localhost:5433/clicker-service_db
TRANSFER_DB_URL=jdbc:postgresql://localhost:5434/transfer-service_db

# --- Redis -------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Kafka -------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLUSTER_ID=ciWo7TVsQPih12W7a2989g

# --- Service ports -----------------------------------------------------------
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
CLICKER_SERVICE_PORT=8082
TRANSFER_SERVICE_PORT=8083

# --- Gateway routes ----------------------------------------------------------
AUTH_SERVICE_URL=http://localhost:8081
CLICKER_SERVICE_URL=http://localhost:8082
TRANSFER_SERVICE_URL=http://localhost:8083
